{
  "name": "proxer",
  "displayName": "Proxer",
  "description": "AI code refactoring and explanations in your own language",
  "version": "0.0.1",
  "publisher": "proxer-dev",
  "license": "MIT",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "proxer.refactor",
        "title": "Proxer: Refactor Code with AI"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "proxer.refactor",
          "group": "modification"
        }
      ]
    },
    "configuration": {
      "title": "Proxer",
      "properties": {
        "proxer.language": {
          "type": "string",
          "default": "",
          "description": "שפת ההסברים (למשל he, en, ar). אם ריק, ישמש שפת הממשק של VS Code."
        },
        "proxer.serverUrl": {
          "type": "string",
          "default": "https://localhost:7201",
          "description": "כתובת שרת Proxer"
        }
      }
    }
  },



  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
